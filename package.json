{
  "name": "worldgl",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "lint": "eslint src/",
    "complexity": "node scripts/complexity-report.mjs",
    "metrics": "tsmetrics analyze ./src",
    "metrics:html": "tsmetrics analyze ./src --format html > metrics.html",
    "dependencies": "depcruise --config .dependency-cruiser.cjs -T err src/",
    "structure": "depcruise --no-config -T json src/ | node scripts/structure.cjs",
    "check": "npm run lint && npm test && npm run build",
    "check:report": "npm run check; result=$?; npm run complexity; npm run metrics; npm run dependencies; npm run structure; exit $result"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.14.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "playwright": "^1.64.1",
    "tsmetrics": "^0.4.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "tsmetrics@0.4.0": true
  }
}
